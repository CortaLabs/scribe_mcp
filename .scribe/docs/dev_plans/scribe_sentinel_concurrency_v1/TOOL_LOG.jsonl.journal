\\\\\\\\\"] else None,\\\\\\\\\\\\\\\\n            environment_info=json.loads(row[\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"environment_info\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"]) if row[\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"environment_info\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"] else None,\\\\\\\\\\\\\\\\n            test_timestamp=datetime.fromisoformat(row[\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"test_timestamp\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"]),\\\\\\\\\\\\\\\\n            requirement_target=row[\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"requirement_target\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"],\\\\\\\\\\\\\\\\n            requirement_met=bool(row[\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"requirement_met\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"]),\\\\\\\\\\\\\\\\n        )\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n    async def get_project_benchmarks(\\\\\\\\\\\\\\\\n        self,\\\\\\\\\\\\\\\\n        *,\\\\\\\\\\\\\\\\n        project_id: int,\\\\\\\\\\\\\\\\n        benchmark_type: Optional[str] = None,\\\\\\\\\\\\\\\\n        limit: int = 100,\\\\\\\\\\\\\\\\n    ) -> List[BenchmarkRecord]:\\\\\\\\\\\\\\\\n        \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"Get benchmark results for a project.\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n        await self._initialise()\\\\\\\\\\\\\\\\n        params = [project_id]\\\\\\\\\\\\\\\\n        query = \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n            SELECT id, project_id, benchmark_type, test_name, metric_name, metric_value,\\\\\\\\\\\\\\\\n                   metric_unit, test_parameters, environment_info, test_timestamp,\\\\\\\\\\\\\\\\n                   requirement_target, requirement_met\\\\\\\\\\\\\\\\n            FROM benchmarks\\\\\\\\\\\\\\\\n            WHERE project_id = ?\\\\\\\\\\\\\\\\n        \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n        if benchmark_type:\\\\\\\\\\\\\\\\n            query += \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" AND benchmark_type = ?\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n            params.append(benchmark_type)\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n        query += \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" ORDER BY test_timestamp DESC LIMIT ?\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n        params.append(limit)\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n        rows = await self._fetchall(query, tuple(params))\\\\\\\\\\\\\\\\n        results = []\\\\\\\\\\\\\\\\n        for row in rows:\\\\\\\\\\\\\\\\n            results.append(BenchmarkRecord(\\\\\\\\\\\\\\\\n                id=row[\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"id\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"],\\\\\\\\\\\\\\\\n                project_id=row[\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"project_id\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"],\\\\\\\\\\\\\\\\n                benchmark_type=row[\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"benchmark_type\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"],\\\\\\\\\\\\\\\\n                test_name=row[\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"test_name\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"],\\\\\\\\\\\\\\\\n                metric_name=row[\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"metric_name\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"],\\\\\\\\\\\\\\\\n                metric_value=row[\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"metric_value\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"],\\\\\\\\\\\\\\\\n                metric_unit=row[\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"metric_unit\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"],\\\\\\\\\\\\\\\\n                test_parameters=json.loads(row[\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"test_parameters\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"]) if row[\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"test_parameters\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"] else None,\\\\\\\\\\\\\\\\n                environment_info=json.loads(row[\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"environment_info\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"]) if row[\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"environment_info\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"] else None,\\\\\\\\\\\\\\\\n                test_timestamp=datetime.fromisoformat(row[\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"test_timestamp\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"]),\\\\\\\\\\\\\\\\n                requirement_target=row[\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"requirement_target\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"],\\\\\\\\\\\\\\\\n                requirement_met=bool(row[\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"requirement_met\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"]),\\\\\\\\\\\\\\\\n            ))\\\\\\\\\\\\\\\\n        return results\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n    async def store_performance_metric(\\\\\\\\\\\\\\\\n        self,\\\\\\\\\\\\\\\\n        *,\\\\\\\\\\\\\\\\n        project_id: int,\\\\\\\\\\\\\\\\n        metric_category: str,\\\\\\\\\\\\\\\\n        metric_name: str,\\\\\\\\\\\\\\\\n        metric_value: float,\\\\\\\\\\\\\\\\n        metric_unit: str,\\\\\\\\\\\\\\\\n        baseline_value: Optional[float] = None,\\\\\\\\\\\\\\\\n        metadata: Optional[Dict[str, Any]] = None,\\\\\\\\\\\\\\\\n    ) -> PerformanceMetricsRecord:\\\\\\\\\\\\\\\\n        \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"Store a performance metric.\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n        await self._initialise()\\\\\\\\\\\\\\\\n        meta_json = json.dumps(metadata or {}, sort_keys=True)\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n        # Calculate improvement percentage if baseline provided\\\\\\\\\\\\\\\\n        improvement_percentage = None\\\\\\\\\\\\\\\\n        if baseline_value is not None and baseline_value != 0:\\\\\\\\\\\\\\\\n            improvement_percentage = ((metric_value - baseline_value) / abs(baseline_value)) * 100\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n        row = await self._fetchone(\\\\\\\\\\\\\\\\n            \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n          