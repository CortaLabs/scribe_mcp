byte_end\\\\\\\\\\\\\\\": 60847, \\\\\\\\\\\\\\\"byte_start\\\\\\\\\\\\\\\": 51266, \\\\\\\\\\\\\\\"chunk_index\\\\\\\\\\\\\\\": 6, \\\\\\\\\\\\\\\"content\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\"            await self._execute(\\\\\\\\\\\\\\\\n                \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n                INSERT INTO phases (project_id, dev_plan_id, phase_number, phase_name, status,\\\\\\\\\\\\\\\\n                                 start_date, end_date, deliverables_count, deliverables_completed,\\\\\\\\\\\\\\\\n                                 confidence_score, metadata)\\\\\\\\\\\\\\\\n                VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)\\\\\\\\\\\\\\\\n                ON CONFLICT(project_id, phase_number)\\\\\\\\\\\\\\\\n                DO UPDATE SET phase_name = excluded.phase_name,\\\\\\\\\\\\\\\\n                              status = excluded.status,\\\\\\\\\\\\\\\\n                              start_date = excluded.start_date,\\\\\\\\\\\\\\\\n                              end_date = excluded.end_date,\\\\\\\\\\\\\\\\n                              deliverables_count = excluded.deliverables_count,\\\\\\\\\\\\\\\\n                              deliverables_completed = excluded.deliverables_completed,\\\\\\\\\\\\\\\\n                              confidence_score = excluded.confidence_score,\\\\\\\\\\\\\\\\n                              metadata = excluded.metadata;\\\\\\\\\\\\\\\\n                \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\n                (project_id, dev_plan_id, phase_number, phase_name, status,\\\\\\\\\\\\\\\\n                 start_date, end_date, deliverables_count, deliverables_completed,\\\\\\\\\\\\\\\\n                 confidence_score, meta_json),\\\\\\\\\\\\\\\\n            )\\\\\\\\\\\\\\\\n        row = await self._fetchone(\\\\\\\\\\\\\\\\n            \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n            SELECT id, project_id, dev_plan_id, phase_number, phase_name, status,\\\\\\\\\\\\\\\\n                   start_date, end_date, deliverables_count, deliverables_completed,\\\\\\\\\\\\\\\\n                   confidence_score, metadata\\\\\\\\\\\\\\\\n            FROM phases\\\\\\\\\\\\\\\\n            WHERE project_id = ? AND phase_number = ?;\\\\\\\\\\\\\\\\n            \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\n            (project_id, phase_number),\\\\\\\\\\\\\\\\n        )\\\\\\\\\\\\\\\\n        return PhaseRecord(\\\\\\\\\\\\\\\\n            id=row[\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"id\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"],\\\\\\\\\\\\\\\\n            project_id=row[\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"project_id\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"],\\\\\\\\\\\\\\\\n            dev_plan_id=row[\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"dev_plan_id\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"],\\\\\\\\\\\\\\\\n            phase_number=row[\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"phase_number\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"],\\\\\\\\\\\\\\\\n            phase_name=row[\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"phase_name\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"],\\\\\\\\\\\\\\\\n            status=row[\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"status\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"],\\\\\\\\\\\\\\\\n            start_date=datetime.fromisoformat(row[\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"start_date\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"]) if row[\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"start_date\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"] else None,\\\\\\\\\\\\\\\\n            end_date=datetime.fromisoformat(row[\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"end_date\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"]) if row[\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"end_date\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"] else None,\\\\\\\\\\\\\\\\n            deliverables_count=row[\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"deliverables_count\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"],\\\\\\\\\\\\\\\\n            deliverables_completed=row[\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"deliverables_completed\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"],\\\\\\\\\\\\\\\\n            confidence_score=row[\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"confidence_score\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"],\\\\\\\\\\\\\\\\n            metadata=json.loads(row[\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"metadata\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"]) if row[\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"metadata\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"] else None,\\\\\\\\\\\\\\\\n        )\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n    async def store_benchmark(\\\\\\\\\\\\\\\\n        self,\\\\\\\\\\\\\\\\n        *,\\\\\\\\\\\\\\\\n        project_id: int,\\\\\\\\\\\\\\\\n        benchmark_type: str,\\\\\\\\\\\\\\\\n        test_name: str,\\\\\\\\\\\\\\\\n        metric_name: str,\\\\\\\\\\\\\\\\n        metric_value: float,\\\\\\\\\\\\\\\\n        metric_unit: str,\\\\\\\\\\\\\\\\n        test_parameters: Optional[Dict[str, Any]] = None,\\\\\\\\\\\\\\\\n        environment_info: Optional[Dict[str, Any]] = None,\\\\\\\\\\\\\\\\n        requirement_target: Optional[float] = None,\\\\\\\\\\\\\\\\n    ) -> BenchmarkRecord:\\\\\\\\\\\\\\\\n        \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"Store a benchmark result.\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n        await self._initialise()\\\\\\\\\\\\\\\\n        test_params_json = json.dumps(test_parameters or {}, sort_keys=True)\\\\\\\\\\\\\\\\n        env_info_json = json.dumps(environment_info or {}, sort_keys=True)\\\\\\\\\\\\\\\\n        requirement_met = (requirement_target is not None and\\\\\\\\\\\\\\\\n                          ((benchmark_type in ['throughput', 'hash_performance'] and metric_value >= requirement_target) or\\\\\\\\\\\\\\\\n                           (benchmark_type in ['latency', 'time'] and metric_value <= requirement_target) or\\\\\\\\\\\\\\\\n                           (requirement_target > 0 and metric_value <= requirement_target) or\\\\\\\\\\\\\\\\n                           (requirement_target < 0 and metric_value >= requirement_target)))\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n        row = await self._fetchone(\\\\\\\\\\\\\\\\n            \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n            INSERT INTO benchmarks (project_id, benchmark_type, test_name, metric_name,\\\\\\\\\\\\\\\\n                                   metric_value, metric_unit, test_parameters, environment_info,\\\\\\\\\\\\\\\\n                                   requirement_target, requirement_met)\\\\\\\\\\\\\\\\n            VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)\\\\\\\\\\\\\\\\n            RETURNING id, project_id, benchmark_type, test_name, metric_name, metric_value,\\\\\\\\\\\\\\\\n                    metric_unit, test_parameters, environment_info, test_timestamp,\\\\\\\\\\\\\\\\n                    requirement_target, requirement_met;\\\\\\\\\\\\\\\\n            \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\n            (project_id, benchmark_type, test_name, metric_name, metric_value,\\\\\\\\\\\\\\\\n             metric_unit, test_params_json, env_info_json, requirement_target, requirement_met),\\\\\\\\\\\\\\\\n        )\\\\\\\\\\\\\\\\n        return BenchmarkRecord(\\\\\\\\\\\\\\\\n            id=row[\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"id\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"],\\\\\\\\\\\\\\\\n            project_id=row[\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"project_id\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"],\\\\\\\\\\\\\\\\n            benchmark_type=row[\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"benchmark_type\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"],\\\\\\\\\\\\\\\\n            test_name=row[\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"test_name\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"],\\\\\\\\\\\\\\\\n            metric_name=row[\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"metric_name\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"],\\\\\\\\\\\\\\\\n            metric_value=row[\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"metric_value\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"],\\\\\\\\\\\\\\\\n            metric_unit=row[\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"metric_unit\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"],\\\\\\\\\\\\\\\\n            test_parameters=json.loads(row[\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"test_parameters\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"]) if row[\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"test_parameters\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"] else None,\\\\\\\\\\\\\\\\n            environment_info=json.loads(row[\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"environment_info\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"]) if row[\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"environment_info\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"] else None,\\\\\\\\\\\\\\\\n            test_timestamp=datetime.fromisoformat(row[\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"test_timestamp\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"]),\\\\\\\\\\\\\\\\n            requirement_target=row[\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"requirement_target\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"],\\\\\\\\\\\\\\\\n            requirement_met=bool(row[\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"requirement_met\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"]),\\\\\\\\\\\\\\\\n        )\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n    async def get_project_benchmarks(\\\\\\\\\\\\\\\\n        self,\\\\\\\\\\\\\\\\n        *,\\\\\\\\\\\\\\\\n        project_id: int,\\\\\\\\\\\\\\\\n        benchmark_type: Optional[str] = None,\\\\\\\\\\\\\\\\n        limit: int = 100,\\\\\\\\\\\\\\\\n    ) -> List[BenchmarkRecord]:\\\\\\\\\\\\\\\\n        \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"Get benchmark results for a project.\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n        await self._initialise()\\\\\\\\\\\\\\\\n        params = [project_id]\\\\\\\\\\\\\\\\n        query = \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\