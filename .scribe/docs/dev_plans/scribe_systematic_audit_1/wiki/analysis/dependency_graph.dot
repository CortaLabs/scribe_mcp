// Scribe MCP Module Dependency Graph
// Generated: 2026-01-05
// Team B (Import Structure Cartographer)
//
// Visualization of module-to-module dependencies
// RED arrows = Circular dependencies (bidirectional)
// BLUE arrows = Normal dependencies
// Node colors by coupling score:
//   - Dark Red: EXTREME coupling (>40 importers)
//   - Orange: HIGH coupling (20-40 importers)
//   - Yellow: MEDIUM coupling (10-20 importers)
//   - Light Green: LOW coupling (<10 importers)

digraph scribe_mcp_dependencies {
    // Graph settings
    rankdir=TB;
    node [shape=box, style=filled, fontname="Arial"];
    edge [fontname="Arial", fontsize=10];

    // Foundation Layer (Layer 0)
    subgraph cluster_0 {
        label="Layer 0: Foundation";
        style=filled;
        color=lightgrey;

        config [label="config\n(47 importers)", fillcolor="#8B0000", fontcolor=white];
    }

    // Infrastructure Layer (Layer 1)
    subgraph cluster_1 {
        label="Layer 1: Infrastructure";
        style=filled;
        color=lightblue;

        security [label="security\n(7 importers)", fillcolor="#90EE90"];
        template_engine [label="template_engine\n(7 importers)", fillcolor="#90EE90"];
        templates [label="templates\n(3 importers)", fillcolor="#90EE90"];
    }

    // Storage Layer (Layer 2)
    subgraph cluster_2 {
        label="Layer 2: Storage & Utilities";
        style=filled;
        color=lightyellow;

        db [label="db\n(1 importers)", fillcolor="#90EE90"];
        storage [label="storage\n(31 importers)", fillcolor="#FFA500", fontcolor=white];
        utils [label="utils\n(63 importers)", fillcolor="#8B0000", fontcolor=white];
    }

    // State Layer (Layer 3)
    subgraph cluster_3 {
        label="Layer 3: State Management";
        style=filled;
        color=lightpink;

        state [label="state\n(20 importers)", fillcolor="#FFFF00"];
    }

    // Application Layer (Layer 4)
    subgraph cluster_4 {
        label="Layer 4: Application Logic";
        style=filled;
        color=lightcyan;

        tools [label="tools\n(57 importers)", fillcolor="#8B0000", fontcolor=white];
        doc_management [label="doc_management\n(16 importers)", fillcolor="#FFFF00"];
        plugins [label="plugins\n(16 importers)", fillcolor="#FFFF00"];
        shared [label="shared\n(30 importers)", fillcolor="#FFA500", fontcolor=white];
        reminders [label="reminders\n(1 importers)", fillcolor="#90EE90"];
    }

    // Interface Layer (Layer 5)
    subgraph cluster_5 {
        label="Layer 5: External Interface";
        style=filled;
        color=wheat;

        server [label="server\n(15 importers)", fillcolor="#FFFF00"];
        scripts [label="scripts\n(0 importers)", fillcolor="#90EE90"];
    }

    // Normal Dependencies (blue arrows)
    config -> security [style=invis]; // Layout hint

    security -> config [color=blue];
    template_engine -> config [color=blue];
    templates -> config [color=blue];
    templates -> utils [color=blue];

    db -> config [color=blue];
    db -> storage [color=blue, label="models"];
    db -> utils [color=blue];

    storage -> config [color=blue];
    storage -> db [color=blue, label="ops"];
    storage -> utils [color=blue];

    utils -> config [color=blue];
    utils -> security [color=blue];

    state -> config [color=blue];
    state -> storage [color=blue];
    state -> utils [color=blue];

    doc_management -> config [color=blue];
    doc_management -> storage [color=blue];
    doc_management -> template_engine [color=blue];
    doc_management -> templates [color=blue];
    doc_management -> utils [color=blue];

    plugins -> config [color=blue];
    plugins -> security [color=blue];
    plugins -> storage [color=blue];
    plugins -> utils [color=blue];

    shared -> config [color=blue];
    shared -> storage [color=blue];

    tools -> config [color=blue];
    tools -> plugins [color=blue];
    tools -> security [color=blue];
    tools -> server [color=blue];
    tools -> state [color=blue];
    tools -> template_engine [color=blue];
    tools -> templates [color=blue];

    reminders -> utils [color=blue];

    server -> config [color=blue];
    server -> state [color=blue];
    server -> storage [color=blue];
    server -> security [color=blue];
    server -> shared [color=blue];
    server -> utils [color=blue];

    scripts -> config [color=blue];
    scripts -> plugins [color=blue];
    scripts -> security [color=blue];
    scripts -> shared [color=blue];
    scripts -> tools [color=blue];
    scripts -> utils [color=blue];

    // CIRCULAR DEPENDENCIES (red bidirectional arrows)

    // 1. tools <-> utils (CRITICAL)
    tools -> utils [color=red, style=bold, label="CIRCULAR"];
    utils -> tools [color=red, style=bold];

    // 2. storage <-> db (CRITICAL)
    // Already shown above with blue, mark as circular
    edge [color=red, style=bold];
    storage -> db [label="CIRCULAR"];
    db -> storage;
    edge [color=blue]; // Reset

    // 3. doc_management <-> tools
    doc_management -> tools [color=red, style=bold, label="CIRCULAR"];
    tools -> doc_management [color=red, style=bold];

    // 4. shared <-> utils
    shared -> utils [color=red, style=bold, label="CIRCULAR"];
    utils -> shared [color=red, style=bold];

    // 5. shared <-> tools
    shared -> tools [color=red, style=bold, label="CIRCULAR"];
    tools -> shared [color=red, style=bold];

    // Legend
    subgraph cluster_legend {
        label="Legend";
        style=filled;
        color=white;

        legend_extreme [label="EXTREME Coupling\n(>40 importers)", fillcolor="#8B0000", fontcolor=white];
        legend_high [label="HIGH Coupling\n(20-40 importers)", fillcolor="#FFA500", fontcolor=white];
        legend_medium [label="MEDIUM Coupling\n(10-20 importers)", fillcolor="#FFFF00"];
        legend_low [label="LOW Coupling\n(<10 importers)", fillcolor="#90EE90"];

        legend_extreme -> legend_high [style=invis];
        legend_high -> legend_medium [style=invis];
        legend_medium -> legend_low [style=invis];
    }

    // Notes
    label="\nScribe MCP Module Dependencies\n439 imports across 152 files | 12 circular dependencies | 5 critical hot spots\nRED = Circular dependency (MUST FIX) | BLUE = Normal dependency\n";
    fontsize=14;
}
