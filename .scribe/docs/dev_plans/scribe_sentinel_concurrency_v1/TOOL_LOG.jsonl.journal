or(Protocol):\\\\n        def __call__(self, func: Callable[..., Awaitable[Any]]) -> Callable[..., Awaitable[Any]]: ...\\\\n\\\\n    class ToolServer(Server):\\\\n        def tool(\\\\n            self,\\\\n            func: Callable[..., Awaitable[Any]]   None = None,\\\\n            **_: Any,\\\\n        ) -> ToolDecorator: ...\\\\n\\\\n        def list_tools(self, *args: Any, **kwargs: Any) -> ToolDecorator: ...\\\\n\\\\n        def call_tool(self, *args: Any, **kwargs: Any) -> ToolDecorator: ...\\\\n\\\\nif TYPE_CHECKING:\\\\n    _server_instance: ToolServer = cast(\\\\\\\"ToolServer\\\\\\\", Server(settings.mcp_server_name))\\\\n    app = _server_instance\\\\nelse:\\\\n    app = Server(settings.mcp_server_name)\\\\nstate_manager = StateManager()\\\\nstorage_backend = create_storage_backend()\\\\nagent_context_manager = None  # Will be initialized in startup\\\\nagent_identity = None  # Will be initialized in startup\\\\nrouter_context_manager = RouterContextManager()\\\\n_startup_complete = False\\\\n\\\\nif _MCP_AVAILABLE:\\\\n    from mcp import types as mcp_types\\\\n\\\\n    if not hasattr(app, \\\\\\\"tool\\\\\\\"):\\\\n        if not hasattr(Server, \\\\\\\"_scribe_tool_registry\\\\\\\"):\\\\n            Server._scribe_tool_registry = {}\\\\n            Server._scribe_tool_defs = {}\\\\n\\\\n        def _tool_decorator(\\\\n            func: Callable[..., Awaitable[Any]]   None = None,\\\\n            *,\\\\n            name: str   None = None,\\\\n            description: str   None = None,\\\\n            input_schema: Dict[str, Any]   None = None,\\\\n            output_schema: Dict[str, Any]   None = None,\\\\n        ):\\\\n\\\", \\\"line_end\\\": 120, \\\"line_start\\\": 1}, \\\"frontmatter\\\": {}, \\\"frontmatter_byte_count\\\": 0, \\\"frontmatter_line_count\\\": 0, \\\"frontmatter_raw\\\": \\\"\\\", \\\"has_frontmatter\\\": false, \\\"mode\\\": \\\"line_range\\\", \\\"ok\\\": true, \\\"reminders\\\": [{\\\"category\\\": \\\"context\\\", \\\"context\\\": \\\"Entries:    Last: \\\", \\\"emoji\\\": \\\"\\\\ud83c\\\\udfaf\\\", \\\"level\\\": \\\"info\\\", \\\"message\\\": \\\"Project: scribe_sentinel_concurrency_v1\\\", \\\"score\\\": 3, \\\"tone\\\": \\\"neutral\\\"}], \\\"scan\\\": {\\\"absolute_path\\\": \\\"/home/austin/projects/MCP_SPINE/scribe_mcp/server.py\\\", \\\"byte_size\\\": 16365, \\\"encoding\\\": \\\"utf-8\\\", \\\"estimated_chunk_count\\\": 3, \\\"line_count\\\": 412, \\\"newline_type\\\": \\\"LF\\\", \\\"repo_relative_path\\\": \\\"server.py\\\", \\\"sha256\\\": \\\"d6a2a4b86208f253d9022727fc46069b09571e2ec99df23ab5efeb939efcc0a2\\\"}}; timestamp=2026-01-03T06:12:34.134578Z; tool=read_file; priority=medium; log_type=tool_logs; content_type=log\", \"ts\": \"2026-01-03 06:12:34 UTC\"}, {\"agent\": \"Codex\", \"category\": null, \"confidence\": 1.0, \"emoji\": \"\\u2139\\ufe0f\", \"id\": \"f44728cd35c456bf8625ccb670ab074c\", \"message\": \"Rehydrated sentinel project context after reboot by setting project and confirming recent logs with read_recent under the current transport_session_id.\", \"meta\": {\"content_type\": \"log\", \"log_type\": \"progress\", \"priority\": \"low\", \"reasoning\": \"{\\\"how\\\": \\\"Called set_project with transport_session_id=codex-session-verify then read_recent for scribe_sentinel_concurrency_v1.\\\", \\\"what\\\": \\\"Constraints: must use read_recent/query_entries; avoid full log reads; bind session scope to avoid global fallbacks.\\\", \\\"why\\\": \\\"Progress log is required before work; reboot cleared session context so set_project was needed to bind the session and verify logs.\\\"}\"}, \"priority\": \"low\", \"raw_line\": \"[\\u2139\\ufe0f] [2026-01-03 06:11:36 UTC] [Agent: Codex] [Project: scribe_sentinel_concurrency_v1] Rehydrated sentinel project context after reboot by setting project and confirming recent logs with read_recent under the current transport_session_id.   reasoning={\\\"how\\\": \\\"Called set_project with transport_session_id=codex-session-verify then read_recent for scribe_sentinel_concurrency_v1.\\\", \\\"what\\\": \\\"Constraints: must use read_recent/query_entries; avoid full log reads; bind session scope to avoid global fallbacks.\\\", \\\"why\\\": \\\"Progress log is required before work; reboot cleared session context so set_project was needed to bind the session and verify logs.\\\"}; priority=low; log_type=progress; content_type=log\", \"ts\": \"2026-01-03 06:11:36 UTC\"}, {\"agent\": \"Scribe\", \"category\": null, \"confidence\": 1.0, \"emoji\": \"\\u2139\\ufe0f\", \"id\": \"4caf510e5a4fe9b489c4711fa991c1b5\", \"message\": \"Tool call: read_recent\", \"meta\": {\"content_type\": \"log\", \"format_requested\": \"readable\", \"log_type\": \"tool_logs\", \"priority\": \"medium\", \"response_data\": \"{\\\"count\\\": 10, \\\"entries\\\": [{\\\"agent\\\": \\\"Codex\\\", \\\"category\\\": null, \\\"confidence\\\": 1.0, \\\"emoji\\\": \\\"\\\\u2705\\\", \\\"id\\\": \\\"ed9e3efec3d657af9bd456b55401f17f\\\", \\\"message\\\": \\\"Adjusted read_file to allow usage without a session-scoped project and added server-side transport_session_id fallback from MCP kwargs (session_id/client_id/connection_id) to auto-supply context when available; still hard-fails if no transport/session id.\\\", \\\"meta\\\": {\\\"content_type\\\": \\\"log\\\", \\\"log_type\\\": \\\"progress\\\", \\\"priority\\\": \\\"medium\\\", \\\"reasoning\\\": \\\"{\\\\\\\"how\\\\\\\": \\\\\\\"Set resolve_logging_context(require_project=False) in read_file logging and added kwargs-based transport_session_id fallback in server call_tool before enforcing session identity.\\\\\\\", \\\\\\\"what\\\\\\\": \\\\\\\"Constraints: keep session identity requirement for concurrency; avoid reintroducing global project fallback; only relax read_file project requirement.\\\\\\\", \\\\\\\"why\\\\\\\": \\\\\\\"User requested auto-supplied context and global read_file access without set_project; current enforcement blocked read_file and forced manual context in calls.\\\\\\\"}\\\"}, \\\"priority\\\": \\\"medium\\\", \\\"raw_line\\\": \\\"[\\\\u2705] [2026-01-03 06:07:53 UTC] [Agent: Codex] [Project: scribe_sentinel_concurrency_v1] Adjusted read_file to allow usage without a session-scoped project and added server-side transport_session_id fallback from MCP kwargs (session_id/client_id/connection_id) to auto-supply context when available; still hard-fails if no transport/session id.   reasoning={\\\\\\\"how\\\\\\\": \\\\\\\"Set resolve_logging_context(require_project=False) in read_file logging and added kwargs-based transport_session_id fallback in server call_tool before enforcing session identity.\\\\\\\", \\\\\\\"what\\\\\\\": \\\\\\\"Constraints: keep session identity requirement for concurrency; avoid reintroducing global project fallback; only relax read_file project requirement.\\\\\\\", \\\\\\\"why\\\\\\\": \\\\\\\"User requested auto-supplied context and global read_file access without set_project; current enforcement blocked read_file and forced manual context in calls.\\\\\\\"}; priority=medium; log_type=progress; content_type=log\\\", \\\"ts\\\": \\\"2026-01-03 06:07:53 UTC\\\"}, {\\\"agent\\\": \\\"Codex\\\", \\\"category\\\": null, \\\"confidence\\\": 1.0, \\\"emoji\\\": \\\"\\\\u2705\\\", \\\"id\\\": \\\"fee87dc4490d5c79426f70b5b56d1b6d\\\", \\\"message\\\": \\\"Aligned set_project session_projects mapping with router ExecutionContext by using context.session_id (when available) for state_manager.set_current_project; preserves agent_manager session id for DB while unblocking session-scoped project resolution.\\\", \\\"meta\\\": {\\\"content_type\\\": \\\"log\\\", \\\"log_type\\\": \\\"progress\\\", \\\"priority\\\": \\\"medium\\\", \\\"reasoning\\\": \\\"{\\\\\\\"how\\\\\\\": \\\\\\\"Captured ExecutionContext in set_project and passed context.session_id to state_manager.set_current_project (fallback to agent session id if absent).\\\\\\\", \\\\\\\"what\\\\\\\": \\\\\\\"Constraints: keep agent_manager session id for DB/audit; avoid breaking legacy fallback; use ExecutionContext when present.\\\\\\\", \\\\\\\"why\\\\\\\": \\\\\\\"Read_file/logging now resolve session projects by exec_context.session_id; using only agent_manager session id left session_projects empty for tool calls tied to transport_session_id.\\\\\\\"}\\\"}, \\\"priority\\\": \\\"medium\\\", \\\"raw_line\\\": \\\"[\\\\u2705] [2026-01-03 06:04:34 UTC] [Agent: Codex] [Project: scribe_sentinel_concurrency_v1] Aligned set_project session_projects mapping with router ExecutionContext by using context.session_id (when available) for state_manager.set_current_project; preserves agent_manager session id for DB while unblocking session-scoped project resolution.   reasoning={\\\\\\\"how\\\\\\\": \\\\\\\"Captured ExecutionContext in set_project and passed context.session_id to state_manager.set_current_project (fallback to agent session id if absent).\\\\\\\", \\\\\\\"what\\\\\\\": \\\\\\\"Constraints: keep agent_manager session id for DB/audit; avoid breaking legacy fallback; use ExecutionContext when present.\\\\\\\", \\\\\\\"why\\\\\\\": \\\\\\\"Read_file/logging now resolve session projects by exec_context.session_id; using only agent_manager session id left session_projects empty for tool calls tied to transport_session_id.\\\\\\\"}; priority=medium; log_type=progress; content_type=log\\\", \\\"ts\\\": \\\"2026-01-03 06:04:34 UTC\\\"}, {\\\"agent\\\": \\\"Codex\\\", \\\"category\\\": null, \\\"confidence\\\": 1.0, \\\"emoji\\\": \\\"\\\\u26a0\\\\ufe0f\\\", \\\"id\\\": \\\"58b4fa2f0b4adc41f05710a56b373042\\\", \\\"message\\\": \\\"read_file failed before session context was bound: \\\\\\\"No session-scoped project configured\\\\\\\"; set_project re-run with transport_session_id to bind context before further inspection.\\\", \\\"meta\\\": {\\\"content_type\\\": \\\"log\\\", \\\"log_type\\\": \\\"progress\\\", \\\"priority\\\": \\\"medium\\\", \\\"reasoning\\\": \\\"{\\\\\\\"how\\\\\\\": \\\\\\\"Re-ran set_project with transport_session_id=codex-session-verify, then proceeded to re-attempt read_file.\\\\\\\", \\\\\\\"what\\\\\\\": \\\\\\\"Constraints: must log tool failures; need to set_project with same session id before further tool calls; keep context consistent.\\\\\\\", \\\\\\\"why\\\\\\\": \\\\\\\"Step 2 blocks project-mode global fallback, so read_file requires a session-scoped project; initial attempt lacked that binding.\\\\\\\"}\\\"}, \\\"priority\\\": \\\"medium\\\", \\\"raw_line\\\": \\\"[\\\\u26a0\\\\ufe0f] [2026-01-03 06:03:50 UTC] [Agent: Codex] [Project: scribe_sentinel_concurrency_v1] read_file failed before session context was bound: \\\\\\\"No session-scoped project configured\\\\\\\"; set_project re-run with transport_session_id to bind context before further inspection.   reasoning={\\\\\\\"how\\\\\\\": \\\\\\\"Re-ran set_project with transport_session_id=codex-session-verify, then proceeded to re-attempt read_file.\\\\\\\", \\\\\\\"what\\\\\\\": \\\\\\\"Constraints: must log tool failures; need to set_project with same session id before further tool calls; keep context consistent.\\\\\\\", \\\\\\\"why\\\\\\\": \\\\\\\"Step 2 blocks project-mode global fallback, so read_file requires a session-scoped project; initial attempt lacked that binding.\\\\\\\"}; priority=medium; log_type=progress; content_type=log\\\", \\\"ts\\\": \\\"2026-01-03 06:03:50 UTC\\\"}, {\\\"agent\\\": \\\"Codex\\\", \\\"category\\\": null, \\\"confidence\\\": 1.0, \\\"emoji\\\": \\\"\\\\u2705\\\", \\\"id\\\": \\\"ebb9e3d37a188e99551440a280507f7e\\\", \\\"message\\\": \\\"Step 3 concurrency fix: added mirror_global flag to StateManager.set_current_project, stopped set_project from updating global current_project when agent session succeeds, and prevented manage_docs registry updates from mutating global current_project; added state manager test for session-only updates.\\\", \\\"meta\\\": {\\\"content_type\\\": \\\"log\\\", \\\"log_type\\\": \\\"progress\\\", \\\"priority\\\": \\\"medium\\\", \\\"reasoning\\\": \\\"{\\\\\\\"how\\\\\\\": \\\\\\\"Updated state/manager.py to support mirror_global, set tools/set_project.py to disable global mirroring when agent context succeeds, set tools/manage_docs.py registry updates to mirror_global=False, and added tests/test_utils.py coverage for session-only updates.\\\\\\\", \\\\\\\"what\\\\\\\": \\\\\\\"Constraints: keep legacy fallback for non-session flows; avoid touching unrelated callers; add minimal test coverage.\\\\\\\", \\\\\\\"why\\\\\\\": \\\\\\\"Step 3 requires removing global current_project mirroring so concurrent sessions don't overwrite each other while preserving legacy behavior when no session context exists.\\\\\\\"}\\\"}, \\\"priority\\\": \\\"medium\\\", \\\"raw_line\\\": \\\"[\\\\u2705] [2026-01-03 05:59:08 UTC] [Agent: Codex] [Project: scribe_sentinel_concurrency_v1] Step 3 concurrency fix: added mirror_global flag to StateManager.set_current_project, stopped set_project from updating global current_project when agent session succeeds, and prevented manage_docs registry updates from mutating global current_project; added state manager test for session-only updates.   reasoning={\\\\\\\"how\\\\\\\": \\\\\\\"Updated state/manager.py to support mirror_global, set tools/set_project.py to disable global mirroring when agent context succeeds, set tools/manage_docs.py registry updates to mirror_global=False, and added tests/test_utils.py coverage for session-only updates.\\\\\\\", \\\\\\\"what\\\\\\\": \\\\\\\"Constraints: keep legacy fallback for non-session flows; avoid touching unrelated callers; add minimal test coverage.\\\\\\\", \\\\\\\"why\\\\\\\": \\\\\\\"Step 3 requires removing global current_project mirroring so concurrent sessions don't overwrite each other while preserving legacy behavior when no session context exists.\\\\\\\"}; priority=medium; log_type=progress; content_type=log\\\", \\\"ts\\\": \\\"2026-01-03 05:59:08 UTC\\\"}, {\\\"agent\\\": \\\"Scribe\\\", \\\"category\\\": null, \\\"confidence\\\": 1.0, \\\"emoji\\\": \\\"\\\\u2139\\\\ufe0f\\\", \\\"id\\\": \\\"1dbc4169a1aa4b1b60fc703a1a45e5a2\\\", \\\"message\\\": \\\"Tool call: read_file\\\", \\\"meta\\\": {\\\"content_type\\\": \\\"log\\\", \\\"format_requested\\\": \\\"readable\\\", \\\"log_type\\\": \\\"tool_logs\\\", \\\"priority\\\": \\\"medium\\\", \\\"response_data\\\": \\\"{\\\\\\\"chunks\\\\\\\": [{\\\\\\\"byte_end\\\\\\\": 3369, \\\\\\\"byte_start\\\\\\\": 0, \\\\\\\"chunk_index\\\\\\\": 0, \\\\\\\"content\\\\\\\": \\\\\\\"\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\"Unit tests for utility helpers and state management.\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\"\\\\\\\\n\\\\\\\\nfrom __future__ import annotations\\\\\\\\n\\\\\\\\nimport json\\\\\\\\nimport shutil\\\\\\\\nfrom pathlib import Path\\\\\\\\n\\\\\\\\nimport pytest\\\\\\\\nimport sys\\\\\\\\n\\\\\\\\n# Add the MCP_SPINE directory to Python path for imports\\\\\\\\nsys.path.insert(0, str(Path(__file__).parent.parent))\\\\\\\\n\\\\\\\\nfrom scribe_mcp.state.manager import StateManager\\\\\\\\nfrom scribe_mcp.config.settings import settings\\\\\\\\nfrom scribe_mcp.tools import set_project\\\\\\\\nfrom scribe_mcp.tools.append_entry import (\\\\\\\\n    _normalise_meta,\\\\\\\\n    _sanitize_identifier,\\\\\\\\n    _validate_message,\\\\\\\\n)\\\\\\\\nfrom scribe_mcp.shared.logging_utils import _clean_meta_value\\\\\\\\n\\\\\\\\n\\\\\\\\ndef test_sanitize_identifier_strips_brackets():\\\\\\\\n    assert _sanitize_identifier(\\\\\\\\\\\\\\\"[Agent: Test]\\\\\\\\\\\\\\\") == \\\\\\\\\\\\\\\"Agent: Test\\\\\\\\\\\\\\\"\\\\\\\\n    assert _sanitize_identifier(\\\\\\\\\\\\\\\" Scribe \\\\\\\\\\\\\\\") == \\\\\\\\\\\\\\\"Scribe\\\\\\\\\\\\\\\"\\\\\\\\n    assert _sanitize_identifier(\\\\\\\\\\\\\\\"   \\\\\\\\\\\\\\\") == \\\\\\\\\\\\\\\"Scribe\\\\\\\\\\\\\\\"\\\\\\\\n\\\\\\\\n\\\\\\\\ndef test_validate_message_disallows_newlines_and_pipes():\\\\\\\\n    assert _validate_message(\\\\\\\\\\\\\\\"hello\