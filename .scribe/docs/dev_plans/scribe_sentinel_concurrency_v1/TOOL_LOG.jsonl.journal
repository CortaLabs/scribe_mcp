\\\\\\\\\\\\\\\nfrom __future__ import annotations\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nfrom abc import ABC, abstractmethod\\\\\\\\\\\\\\\\nfrom datetime import datetime\\\\\\\\\\\\\\\\nfrom typing import Any, Dict, List, Optional, Tuple\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nfrom scribe_mcp.storage.models import ProjectRecord\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nclass ConflictError(Exception):\\\\\\\\\\\\\\\\n    \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"Raised when an optimistic concurrency conflict occurs.\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n    pass\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nclass StorageBackend(ABC):\\\\\\\\\\\\\\\\n    \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"Unified interface for persistence layers.\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n    async def setup(self) -> None:\\\\\\\\\\\\\\\\n        \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"Perform any startup work. Optional for some backends.\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n    async def close(self) -> None:\\\\\\\\\\\\\\\\n        \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"Release held resources.\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n    @abstractmethod\\\\\\\\\\\\\\\\n    async def upsert_project(\\\\\\\\\\\\\\\\n        self,\\\\\\\\\\\\\\\\n        *,\\\\\\\\\\\\\\\\n        name: str,\\\\\\\\\\\\\\\\n        repo_root: str,\\\\\\\\\\\\\\\\n        progress_log_path: str,\\\\\\\\\\\\\\\\n    ) -> ProjectRecord:\\\\\\\\\\\\\\\\n        \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"Insert or update a project row and return the record.\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n    @abstractmethod\\\\\\\\\\\\\\\\n    async def fetch_project(self, name: str) -> Optional[ProjectRecord]:\\\\\\\\\\\\\\\\n        \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"Return the project by name when present.\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n    @abstractmethod\\\\\\\\\\\\\\\\n    async def list_projects(self) -> List[ProjectRecord]:\\\\\\\\\\\\\\\\n        \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"Return all known projects.\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n    @abstractmethod\\\\\\\\\\\\\\\\n    async def delete_project(self, name: str) -> bool:\\\\\\\\\\\\\\\\n        \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"Delete a project and all associated data. Returns True if project was deleted.\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n    @abstractmethod\\\\\\\\\\\\\\\\n    async def insert_entry(\\\\\\\\\\\\\\\\n        self,\\\\\\\\\\\\\\\\n        *,\\\\\\\\\\\\\\\\n        entry_id: str,\\\\\\\\\\\\\\\\n        project: ProjectRecord,\\\\\\\\\\\\\\\\n        ts: datetime,\\\\\\\\\\\\\\\\n        emoji: str,\\\\\\\\\\\\\\\\n        agent: Optional[str],\\\\\\\\\\\\\\\\n        message: str,\\\\\\\\\\\\\\\\n        meta: Optional[Dict[str, Any]],\\\\\\\\\\\\\\\\n        raw_line: str,\\\\\\\\\\\\\\\\n        sha256: str,\\\\\\\\\\\\\\\\n    ) -> None:\\\\\\\\\\\\\\\\n        \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"Insert a progress log entry and update metrics.\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n    async def record_doc_change(\\\\\\\\\\\\\\\\n        self,\\\\\\\\\\\\\\\\n        project: ProjectRecord,\\\\\\\\\\\\\\\\n        *,\\\\\\\\\\\\\\\\n        doc: str,\\\\\\\\\\\\\\\\n        section: Optional[str],\\\\\\\\\\\\\\\\n        action: str,\\\\\\\\\\\\\\\\n        agent: Optional[str],\\\\\\\\\\\\\\\\n        metadata: Optional[Dict[str, Any]],\\\\\\\\\\\\\\\\n        sha_before: str,\\\\\\\\\\\\\\\\n        sha_after: str,\\\\\\\\\\\\\\\\n    ) -> None:\\\\\\\\\\\\\\\\n        \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"Record a documentation change (optional for storage backends).\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n    async def record_agent_report_card(\\\\\\\\\\\\\\\\n        self,\\\\\\\\\\\\\\\\n        project: ProjectRecord,\\\\\\\\\\\\\\\\n        *,\\\\\\\\\\\\\\\\n        file_path: str,\\\\\\\\\\\\\\\\n        agent_name: str,\\\\\\\\\\\\\\\\n        stage: Optional[str],\\\\\\\\\\\\\\\\n        overall_grade: Optional[float],\\\\\\\\\\\\\\\\n        performance_level: Optional[str],\\\\\\\\\\\\\\\\n        metadata: Optional[Dict[str, Any]],\\\\\\\\\\\\\\\\n    ) -> None:\\\\\\\\\\\\\\\\n        \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"Persist agent report card metadata (optional for storage backends).\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n        raise NotImplementedError\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n    @abstractmethod\\\\\\\\\\\\\\\\n    async def fetch_recent_entries(\\\\\\\\\\\\\\\\n        self,\\\\\\\\\\\\\\\\n        *,\\\\\\\\\\\\\\\\n        project: ProjectRecord,\\\\\\\\\\\\\\\\n        limit: int,\\\\\\\\\\\\\\\\n        filters: Optional[Dict[str, Any]] = None,\\\\\\\\\\\\\\\\n        offset: int = 0,\\\\\\\\\\\\\\\\n    ) -> List[Dict[str, Any]]:\\\\\\\\\\\\\\\\n        \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"Return recent entries for the given project.\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n    async def fetch_recent_entries_paginated(\\\\\\\\\\\\\\\\n        self,\\\\\\\\\\\\\\\\n        *,\\\\\\\\\\\\\\\\n        project: ProjectRecord,\\\\\\\\\\\\\\\\n        page: int = 1,\\\\\\\\\\\\\\\\n        page_size: int = 50,\\\\\\\\\\\\\\\\n        filters: Optional[Dict[str, Any]] = None,\\\\\\\\\\\\\\\\n    ) -> Tuple[List[Dict[str, Any]], int]:\\\\\\\\\\\\\\\\n        \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n        Return recent entries with pagination metadata.\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n        Args:\\\\\\\\\\\\\\\\n            project: Project to fetch entries for\\\\\\\\\\\\\\\\n            page: Page number (1-based)\\\\\\\\\\\\\\\\n            page_size: Number of entries per page\\\\\\\\\\\\\\\\n            filters: Optional filters to apply\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n        Returns:\\\\\\\\\\\\\\\\n            Tuple of (entries, total_count)\\\\\\\\\\\\\\\\n        \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n        # Calculate offset\\\\\\\\\\\\\\\\n        offset = (page - 1) * page_size\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n        # Fetch entries for this page\\\\\\\\\\\\\\\\n        entries = await self.fetch_recent_entries(\\\\\\\\\\\\\\\\n            project=project,\\\\\\\\\\\\\\\\n            limit=page_size,\\\\\\\\\\\\\\\\n            filters=filters,\\\\\\\\\\\\\\\\n            offset=offset\\\\\\\\\\\\\\\\n        )\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n        # Get total count (this varies by backend implementation)\\\\\\\\\\\\\\\\n        total_count = await self.count_entries(project, filters)\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n        return entries, total_count\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n    async def count_entries(\\\\\\\\\\\\\\\\n        self,\\\\\\\\\\\\\\\\n        project: ProjectRecord,\\\\\\\\\\\\\\\\n        filters: Optional[Dict[str, Any]] = None,\\\\\\\\\\\\\\\\n    ) -> int:\\\\\\\\\\\\\\\\n        \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n        Count total entries matching filters.\\\\\\\\\\\\\\\\n        Default implementation - can be overridden by backends for better performance.\\\\\\\\\\\\\\\\n        \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n        # Default implementation - fetch all and count (inefficient)\\\\\\\\\\\\\\\\n        # Backends should override this with proper COUNT queries\\\\\\\\\\\\\\\\n        all_entries = await self.fetch_recent_entries(\\\\\\\\\\\\\\\\n            project=project,\\\\\\\\\\\\\\\\n            limit=10000,  # Large limit to get most entries\\\\\\\\\\\\\\\\n            filters=filters\\\\\\\\\\\\\\\\n        )\\\\\\\\\\\\\\\\n        return len(all_entries)\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n    async def query_entries(\\\\\\\\\\\\\\\\n        self,\\\\\\\\\\\\\\\\n        *,\\\\\\\\\\\\\\\\n        project: ProjectRecord,\\\\\\\\\\\\\\\\n        limit: int,\\\\\\\\\\\\\\\\n        start: Optional[str] = None,\\\\\\\\\\\\\\\\n        end: Optional[str] = None,\\\\\\\\\\\\\\\\n        agents: Optional[List[str]] = None,\\\\\\\\\\\\\\\\n        emojis: Optional[List[str]] = None,\\\\\\\\\\\\\\\\n        message: Optional[str] = None,\\\\\\\\\\\\\\\\n        messa