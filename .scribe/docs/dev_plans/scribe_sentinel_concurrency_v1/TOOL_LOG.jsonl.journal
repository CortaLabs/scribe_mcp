hunk_index\\\\\\\\\\\\\\\": 0, \\\\\\\\\\\\\\\"content\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"SQLite storage backend (default).\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nfrom __future__ import annotations\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nimport asyncio\\\\\\\\\\\\\\\\nimport json\\\\\\\\\\\\\\\\nimport sqlite3\\\\\\\\\\\\\\\\nfrom datetime import datetime\\\\\\\\\\\\\\\\nfrom pathlib import Path\\\\\\\\\\\\\\\\nfrom typing import Any, Dict, List, Optional\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nfrom scribe_mcp.storage.base import StorageBackend\\\\\\\\\\\\\\\\nfrom scribe_mcp.storage.models import (\\\\\\\\\\\\\\\\n    ProjectRecord, DevPlanRecord, PhaseRecord, MilestoneRecord,\\\\\\\\\\\\\\\\n    BenchmarkRecord, ChecklistRecord, PerformanceMetricsRecord,\\\\\\\\\\\\\\\\n    DocumentSectionRecord, CustomTemplateRecord, DocumentChangeRecord, SyncStatusRecord\\\\\\\\\\\\\\\\n)\\\\\\\\\\\\\\\\nfrom scribe_mcp.utils.time import format_utc, utcnow\\\\\\\\\\\\\\\\nfrom scribe_mcp.utils.search import message_matches\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nSQLITE_TIMEOUT_SECONDS = 30\\\\\\\\\\\\\\\\nSQLITE_BUSY_TIMEOUT_MS = 5000\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nclass SQLiteStorage(StorageBackend):\\\\\\\\\\\\\\\\n    \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"SQLite-backed persistence with lazy connections.\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n    def __init__(self, db_path: Path   str) -> None:\\\\\\\\\\\\\\\\n        self._path = Path(db_path).expanduser()\\\\\\\\\\\\\\\\n        self._init_lock = asyncio.Lock()\\\\\\\\\\\\\\\\n        self._write_lock = asyncio.Lock()\\\\\\\\\\\\\\\\n        self._initialised = False\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n    async def setup(self) -> None:\\\\\\\\\\\\\\\\n        await self._initialise()\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n    async def close(self) -> None:  # pragma: no cover - nothing persistent to close\\\\\\\\\\\\\\\\n        # Connections are short-lived; nothing to do.\\\\\\\\\\\\\\\\n        return None\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n    async def upsert_project(\\\\\\\\\\\\\\\\n        self,\\\\\\\\\\\\\\\\n        *,\\\\\\\\\\\\\\\\n        name: str,\\\\\\\\\\\\\\\\n        repo_root: str,\\\\\\\\\\\\\\\\n        progress_log_path: str,\\\\\\\\\\\\\\\\n    ) -> ProjectRecord:\\\\\\\\\\\\\\\\n        await self._initialise()\\\\\\\\\\\\\\\\n        async with self._write_lock:\\\\\\\\\\\\\\\\n            await self._execute(\\\\\\\\\\\\\\\\n            \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n            INSERT INTO scribe_projects (name, repo_root, progress_log_path)\\\\\\\\\\\\\\\\n            VALUES (?, ?, ?)\\\\\\\\\\\\\\\\n            ON CONFLICT(name)\\\\\\\\\\\\\\\\n            DO UPDATE SET repo_root = excluded.repo_root,\\\\\\\\\\\\\\\\n                          progress_log_path = excluded.progress_log_path;\\\\\\\\\\\\\\\\n            \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\n            (name, repo_root, progress_log_path),\\\\\\\\\\\\\\\\n        )\\\\\\\\\\\\\\\\n        row = await self._fetchone(\\\\\\\\\\\\\\\\n            \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n            SELECT id, name, repo_root, progress_log_path\\\\\\\\\\\\\\\\n            FROM scribe_projects\\\\\\\\\\\\\\\\n            WHERE name = ?;\\\\\\\\\\\\\\\\n            \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\n            (name,),\\\\\\\\\\\\\\\\n        )\\\\\\\\\\\\\\\\n        return ProjectRecord(\\\\\\\\\\\\\\\\n            id=row[\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"id\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"],\\\\\\\\\\\\\\\\n            name=row[\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"name\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"],\\\\\\\\\\\\\\\\n            repo_root=row[\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"repo_root\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"],\\\\\\\\\\\\\\\\n            progress_log_path=row[\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"progress_log_path\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"],\\\\\\\\\\\\\\\\n        )\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n    async def fetch_project(self, name: str) -> Optional[ProjectRecord]:\\\\\\\\\\\\\\\\n        await self._initialise()\\\\\\\\\\\\\\\\n        row = await self._fetchone(\\\\\\\\\\\\\\\\n            \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n            SELECT id, name, repo_root, progress_log_path\\\\\\\\\\\\\\\\n            FROM scribe_projects\\\\\\\\\\\\\\\\n            WHERE name = ?;\\\\\\\\\\\\\\\\n            \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\n            (name,),\\\\\\\\\\\\\\\\n        )\\\\\\\\\\\\\\\\n        if not row:\\\\\\\\\\\\\\\\n            return None\\\\\\\\\\\\\\\\n        return ProjectRecord(\\\\\\\\\\\\\\\\n            id=row[\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"id\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"],\\\\\\\\\\\\\\\\n            name=row[\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"name\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"],\\\\\\\\\\\\\\\\n            repo_root=row[\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"repo_root\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"],\\\\\\\\\\\\\\\\n            progress_log_path=row[\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"progress_log_path\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"],\\\\\\\\\\\\\\\\n        )\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n    async def list_projects(self) -> List[ProjectRecord]:\\\\\\\\\\\\\\\\n        await self._initialise()\\\\\\\\\\\\\\\\n        rows = await self._fetchall(\\\\\\\\\\\\\\\\n            \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n            SELECT id, name, repo_root, progress_log_path\\\\\\\\\\\\\\\\n            FROM scribe_projects\\\\\\\\\\\\\\\\n            ORDER BY name;\\\\\\\\\\\\\\\\n            \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n        )\\\\\\\\\\\\\\\\n        records: List[ProjectRecord] = []\\\\\\\\\\\\\\\\n        for row in rows:\\\\\\\\\\\\\\\\n            records.append(\\\\\\\\\\\\\\\\n                ProjectRecord(\\\\\\\\\\\\\\\\n                    id=row[\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"id\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"],\\\\\\\\\\\\\\\\n                    name=row[\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"name\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"],\\\\\\\\\\\\\\\\n                    repo_root=row[\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"repo_root\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"],\\\\\\\\\\\\\\\\n                    progress_log_path=row[\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"progress_log_path\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"],\\\\\\\\\\\\\\\\n                )\\\\\\\\\\\\\\\\n            )\\\\\\\\\\\\\\\\n        return records\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n    async def delete_project(self, name: str) -> bool:\\\\\\\\\\\\\\\\n        \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"Delete a project and all associated data with proper cascade handling.\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n        await self._initialise()\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n        # First check if project exists\\\\\\\\\\\\\\\\n        project = await self.fetch_project(name)\\\\\\\\\\\\\\\\n        if not project:\\\\\\\\\\\\\\\\n            return False\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n        async with self._write_lock:\\\\\\\\\\\\\\\\n            # Delete project and all related data using proper cascade order\\\\\\\\\\\\\\\\n            # SQLite foreign key constraints should handle most of this automatically,\\\\\\\\\\\\\\\\n            # but we'll be explicit for safety and clarity\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n            # Delete agent project associations\\\\\\\\\\\\\\\\n            await self._execute(\\\\\\\\\\\\\\\\n                \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"DELETE FROM agent_projects WHERE project_name = ?;\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\n                (name,),\\\\\\\\\\\\\\\\n            )\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n            # Delete global log entries for this project (if they exist)\\\\\\\\\\\\\\\\n            # Note: global_log_entries uses project_id, but table is currently empty\\\\\\\\\\\\\\\\n            # await self._execute(\\\\\\\\\\\\\\\\n            #     \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"DELETE FROM global_log_entries WHERE project_id = ?;\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\n            #     (name,),\\\\\\\\\\\\\\\\n            # )\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n            # Due to foreign key constraints with ON DELETE CASCADE,\\\\\\\\\\\\\\\\n            # deleting the project should automatically clean up:\\\\\\\\\\\\\\\\n            # - scribe_entries\\\\\\\\\\\\\\\\n            # - dev_plans -> phases -> milestones\\\\\\\\\\\\\\\\n            # - benchmarks, checklists, performance_metrics\\\\\\\\\\\\\\\\n            # - documents -> document_sections, document_changes\\\\\\\\\\\\\\\\n            # - custom_templates, sync_status\\\\\\\\\\\\\\\\n            # - scribe_metrics\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n            # Delete the main project record (this will cascade to related tables)\\\\\\\\\\\\\\\\n            await self._execute(\\\\\\\\\\\\\\\\n                \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"DELETE FROM scribe_projects WHERE name = ?;\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\n                (name,),\\\\\\\\\\\\\\\\n            )\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n            # Verify deletion\\\\\\\\\\\\\\\\n            remaining = await self._fetchone(\\\\\\\\\\\\\\\\n                \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"SELECT COUNT(*) as count FROM scribe_projects WHERE name = ?;\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\n                (name,),\\\\\\\\\\\\\\\\n            )\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n            return remaining[\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"count\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"] == 0\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n    async def insert_entry(\\\\\\\\\\\\\\\\n        self,\\\\\\\\\\\\\\\\n        *,\\\\\\\\\\\\\\\\n        entry_id: str,\\\\\\\\\\\\\\\\n        project: ProjectRecord,\\\\\\\\\\\\\\\\n        ts: datetime,\\\\\\\\\\\\\\\\n        emoji: str,\\\\\\\\\\\\\\\\n        agent: Optional[str],\\\\\\\\\\\\\\\\n        message: str,\\\\\\\\\\\\\\\\n        meta: Optional[Dict[str, Any]],\\\\\\\\\\\\\\\\n        raw_line: str,\\\\\\\\\\\\\\\\n        sha256: str,\\\\\\\\\\\\\\\\n        priority: Optional[str] = None,\\\\\\\\\\\\\\\\n        category: Optional[str] = None,\\\\\\\\\\\\\\\\n        tags: Optional[str] = None,\\\\\\\\\\\\\\\\n        confidence: Optional[float] = None,\\\\\\\\\\\\\\\\n    ) -> None:\\\\\\\\\\\\\\\\n        await self._initialise()\\\\\\\\\\\\\\\\n        ts_iso = ts.isoformat()\\\\\\\\\\\\\\\\n        meta_json = json.dumps(meta or {}, sort_keys=True)\\\\\\\\\\\\\\\\n        # Extract new fields from meta if not explicitly provided\\\\\\\\\\\\\\\\n        if priority is None and meta:\\\\\\\\\\\\\\\\n            priority = meta.get(\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"priority\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\", \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"medium\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\")\\\\\\\\\\\\\\\\n        elif priority is None:\\\\\\\\\\\\\\\\n            priority = \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"medium\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n        if category is None and meta:\\\\\\\\\\\\\\\\n            category = meta.get(\\\\\\\\\\\\\