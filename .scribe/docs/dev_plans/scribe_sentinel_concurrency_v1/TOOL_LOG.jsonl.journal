\\\\\\\\\\\\\\\\\\\\\\"Scribe\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\ndef test_validate_message_disallows_newlines_and_pipes():\\\\\\\\\\\\\\\\n    assert _validate_message(\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"hello\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\nworld\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\") == \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"Message cannot contain newline characters.\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n    assert _validate_message(\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"pipe   value\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\") == \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"Message cannot contain pipe characters.\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n    assert _validate_message(\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"valid message\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\") is None\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\ndef test_normalise_meta_orders_and_sanitises_keys():\\\\\\\\\\\\\\\\n    meta = {\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"b key\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"value\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\nline\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\", \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"a\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\": 1}\\\\\\\\\\\\\\\\n    pairs = _normalise_meta(meta)\\\\\\\\\\\\\\\\n    assert pairs == ((\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"a\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\", \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"1\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"), (\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"b_key\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\", \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"value line\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"))\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\ndef test_clean_meta_value_replaces_newlines_and_pipes():\\\\\\\\\\\\\\\\n    assert _clean_meta_value(\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"line1\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\nline2 x\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\") == \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"line1 line2 x\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n@pytest.mark.asyncio\\\\\\\\\\\\\\\\nasync def test_set_project_rejects_log_outside_root(tmp_path: Path):\\\\\\\\\\\\\\\\n    safe_root = tmp_path / \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"safe_root\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n    outside_log = tmp_path / \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"elsewhere\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" / \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"PROGRESS_LOG.md\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n    result = await set_project.set_project(\\\\\\\\\\\\\\\\n        name=\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"malicious\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\n        root=str(safe_root),\\\\\\\\\\\\\\\\n        progress_log=str(outside_log),\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\n    assert not result[\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"ok\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"]\\\\\\\\\\\\\\\\n    assert \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"Progress log must be within the project root.\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" in result[\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"error\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"]\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n@pytest.mark.asyncio\\\\\\\\\\\\\\\\nasync def test_set_project_allows_external_root(tmp_path: Path):\\\\\\\\\\\\\\\\n    external_root = tmp_path / \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"external_repo\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n    result = await set_project.set_project(\\\\\\\\\\\\\\\\n        name=\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"external_project\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\n        root=str(external_root),\\\\\\\\\\\\\\\\n    )\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n    try:\\\\\\\\\\\\\\\\n        assert result[\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"ok\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"]\\\\\\\\\\\\\\\\n        assert Path(result[\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"project\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"][\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"root\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"]).resolve() == external_root.resolve()\\\\\\\\\\\\\\\\n        expected_docs = external_root / settings.dev_plans_base / \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"external_project\\\