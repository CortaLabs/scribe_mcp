cted version {expected_version}\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\")\\\\\\\\\\\\\\\\n                result = cursor\\\\\\\\\\\\\\\\n            else:\\\\\\\\\\\\\\\\n                # First time or no version check\\\\\\\\\\\\\\\\n                await self._execute(\\\\\\\\\\\\\\\\n                    \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n                    INSERT INTO agent_projects (agent_id, project_name, version, updated_by, session_id)\\\\\\\\\\\\\\\\n                    VALUES (?, ?, 1, ?, ?)\\\\\\\\\\\\\\\\n                    ON CONFLICT(agent_id) DO UPDATE SET\\\\\\\\\\\\\\\\n                        project_name = excluded.project_name,\\\\\\\\\\\\\\\\n                        version = version + 1,\\\\\\\\\\\\\\\\n                        updated_at = CURRENT_TIMESTAMP,\\\\\\\\\\\\\\\\n                        updated_by = excluded.updated_by,\\\\\\\\\\\\\\\\n                        session_id = excluded.session_id;\\\\\\\\\\\\\\\\n                    \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\n                    (agent_id, project_name, updated_by, session_id)\\\\\\\\\\\\\\\\n                )\\\\\\\\\\\\\\\\n                result = await self.get_agent_project(agent_id)\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n            return result or await self.get_agent_project(agent_id)\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\", \\\\\\\\\\\\\\\"line_end\\\\\\\\\\\\\\\": 1524, \\\\\\\\\\\\\\\"line_start\\\\\\\\\\\\\\\": 1401}], \\\\\\\\\\\\\\\"frontmatter\\\\\\\\\\\\\\\": {}, \\\\\\\\\\\\\\\"frontmatter_byte_count\\\\\\\\\\\\\\\": 0, \\\\\\\\\\\\\\\"frontmatter_line_count\\\\\\\\\\\\\\\": 0, \\\\\\\\\\\\\\\"frontmatter_raw\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\", \\\\\\\\\\\\\\\"has_frontmatter\\\\\\\\\\\\\\\": false, \\\\\\\\\\\\\\\"mode\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\"chunk\\\\\\\\\\\\\\\", \\\\\\\\\\\\\\\"ok\\\\\\\\\\\\\\\": tr