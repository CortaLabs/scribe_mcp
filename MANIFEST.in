# Keep the rebuilt sdist aligned with tracked release truth only.
include README.md
include docs/INSTALL_AND_BOOTSTRAP.md
include docs/TOUR.md
include docs/COMPATIBILITY_MATRIX.md
include docs/RELEASE_SURFACE.md
include docs/RELEASE_FILE_MAP.md
include docs/Scribe_Usage.md
include docs/mcp_server_guide.md
include docs/REMOTE_CLIENT.md
include docs/BRIDGE_DEVELOPMENT.md
include docs/TEMPLATE_VARIABLES.md
include docs/GLOBAL_DEPLOYMENT_GUIDE.md
include docs/STARTUP_PROBE_CONTRACT.md
include docs/next_steps.md
include deploy/README.md
include skills/scribe-integration/SKILL.md
# Wheel-shipped plugin bundles + canonical onboarding skill (P6.6).
# recursive-include captures dotfiles/dotdirs (.codex-plugin/, .mcp.json, ...).
recursive-include src/scribe_mcp/plugins_bundle *
recursive-include src/scribe_mcp/onboarding *
include docs/examples/mcp.json.example
include docs/examples/opencode.json.example
include docs/guides/LIVE_MCP_IMPACT_REPORT_2026-04-17.md
include docs/guides/hooks_setup.md
include docs/guides/manage_docs_agent_guide.md
include docs/guides/manage_docs_troubleshooting.md
include docs/guides/scribe_onboarding_prompt.md
include docs/whitepapers/scribe_mcp_whitepaper.md
exclude docs/guides/CODEX_APPROVAL_ALIGNMENT_HANDOFF_2026-03-30.md

prune build
prune dist
prune .council
prune .claude
prune .codex
prune .scribe
prune logs
prune state
exclude .mcp.json
exclude opencode.json
exclude AGENTS.md
exclude CLAUDE.md
exclude tool_calls.jsonl
global-exclude __pycache__
global-exclude *.py[cod]

# Historical release-surface exclusion retained from Phase 5.
exclude tests/test_phase2_vector_core_removal.py
