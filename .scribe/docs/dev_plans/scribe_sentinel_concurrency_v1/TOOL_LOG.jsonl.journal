\\\\\\\\\\n\\\\\\\\\\\\\\\\n            # Delete global log entries for this project (if they exist)\\\\\\\\\\\\\\\\n            # Note: global_log_entries uses project_id, but table is currently empty\\\\\\\\\\\\\\\\n            # await self._execute(\\\\\\\\\\\\\\\\n            #     \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"DELETE FROM global_log_entries WHERE project_id = ?;\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\n            #     (name,),\\\\\\\\\\\\\\\\n            # )\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n            # Due to foreign key constraints with ON DELETE CASCADE,\\\\\\\\\\\\\\\\n            # deleting the project should automatically clean up:\\\\\\\\\\\\\\\\n            # - scribe_entries\\\\\\\\\\\\\\\\n            # - dev_plans -> phases -> milestones\\\\\\\\\\\\\\\\n            # - benchmarks, checklists, performance_metrics\\\\\\\\\\\\\\\\n            # - documents -> document_sections, document_changes\\\\\\\\\\\\\\\\n            # - custom_templates, sync_status\\\\\\\\\\\\\\\\n            # - scribe_metrics\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n            # Delete the main project record (this will cascade to related tables)\\\\\\\\\\\\\\\\n            await self._execute(\\\\\\\\\\\\\\\\n                \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"DELETE FROM scribe_projects WHERE name = ?;\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\n                (name,),\\\\\\\\\\\\\\\\n            )\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n            # Verify deletion\\\\\\\\\\\\\\\\n            remaining = await self._fetchone(\\\\\\\\\\\\\\\\n                \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"SELECT COUNT(*) as count FROM scribe_projects WHERE name = ?;\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\n                (name,),\\\\\\\\\\\\\\\\n            )\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n            return remaining[\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"count\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"] == 0\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n    async def insert_entry(\\\\\\\\\\\\\\\\n        self,\\\\\\\\\\\\\\\\n        *,\\\\\\\\\\\\\\\\n        entry_id: str,\\\\\\\\\\\\\\\\n        project: ProjectRecord,\\\\\\\\\\\\\\\\n        ts: datetime,\\\\\\\\\\\\\\\\n        emoji: str,\\\\\\\\\\\\\\\\n        agent: Optional[str],\\\\\\\\\\\\\\\\n        message: str,\\\\\\\\\\\\\\\\n        meta: Optional[Dict[str, Any]],\\\\\\\\\\\\\\\\n        raw_line: str,\\\\\\\\\\\\\\\\n        sha256: str,\\\\\\\\\\\\\\\\n        priority: Optional[str] = None,\\\\\\\\\\\\\\\\n        category: Optional[str] = None,\\\\\\\\\\\\\\\\n        tags: Optional[str] = None,\\\\\\\\\\\\\\\\n        confidence: Optional[float] = None,\\\\\\\\\\\\\\\\n    ) -> None:\\\\\\\\\\\\\\\\n        await self._initialise()\\\\\\\\\\\\\\\\n        ts_iso = ts.isoformat()\\\\\\\\\\\\\\\\n        meta_json = json.dumps(meta or {}, sort_keys=True)\\\\\\\\\\\\\\\\n        # Extract new fields from meta if not explicitly provided\\\\\\\\\\\\\\\\n        if priority is None and meta:\\\\\\\\\\\\\\\\n            priority = meta.get(\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"priority\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\", \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"medium\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\")\\\\\\\\\\\\\\\\n        elif priority is None:\\\\\\\\\\\\\\\\n            priority = \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"medium\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n        if category is None and meta:\\\\\\\\\\\\\\\\n            category = meta.get(\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"category\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\")\\\\\\\\\\\\\\\\n        if tags is None and meta:\\\\\\\\\\\\\\\\n            tags = meta.get(\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"tags\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\")\\\\\\\\\\\\\\\\n        if confidence is None and meta:\\\\\\\\\\\\\\\\n            confidence = meta.get(\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"confidence\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\", 1.0)\\\\\\\\\\\\\\\\n        elif confidence is None:\\\\\\\\\\\\\\\\n            confidence = 1.0\\\\\\\\\\\\\\\\n        async with self._write_lock:\\\\\