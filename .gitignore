# =====================================================
# Scribe MCP — .gitignore
# =====================================================

# -----------------------------------------------------
# Python Artifacts
# -----------------------------------------------------
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.eggs/
.venv/
*.lock
build/
dist/
pip-wheel-metadata/

# -----------------------------------------------------
# Environment & Secrets
# -----------------------------------------------------
.env
config.toml

# -----------------------------------------------------
# Database & State Files
# -----------------------------------------------------
*.db
*.db-shm
*.db-wal
*.journal
.scribe/state.json
.scribe/state/
.scribe/cli/*.json
.scribe/backups/
state/

# -----------------------------------------------------
# Vector / Embedding Artifacts
# -----------------------------------------------------
.scribe_vectors/
*.faiss
*.npy
*.shard

# -----------------------------------------------------
# Data Directories
# -----------------------------------------------------
data/*.db
data/backups/
data/snapshots/
reports/
benchmarks/artifacts/

# -----------------------------------------------------
# Temporary / Test Directories
# -----------------------------------------------------
tmp_tests/
tmp_manual*/
tmp_state*.json
workspaces/

# -----------------------------------------------------
# Generated Code Exports
# -----------------------------------------------------
*_fullcode.txt
scribe_fullcode.txt
fullcode.txt

# -----------------------------------------------------
# Backups
# -----------------------------------------------------
*.bak
*.preflight-*.bak

# -----------------------------------------------------
# Tool Logs
# -----------------------------------------------------
TOOL_LOG.*.*.md

# -----------------------------------------------------
# Documentation
# -----------------------------------------------------
docs/archived_projects/
docs/archived_global_logs/
docs/dev_plans/
docs/bugs/
docs/security/
research/

# -----------------------------------------------------
# Scribe runtime / operator state (local-only)
# -----------------------------------------------------
.scribe/logs/
.scribe/sentinel/
.scribe/docs/
.scribe/data/
tool_calls.jsonl


# -----------------------------------------------------
# Council boundary (private)
# -----------------------------------------------------
.council/
src/scribe_mcp/council_templates/

# -----------------------------------------------------
# Generated orchestration / mirror artifacts
# -----------------------------------------------------
# Public git is source-safe: do not treat generated orchestration outputs as
# committed source-of-truth. Regenerate them from `.council/**` or the packaged
# export lane in `src/scribe_mcp/council_templates/**`.
AGENTS.md
CLAUDE.md
.claude/CLAUDE.md
src/scribe_mcp/config/CLAUDE.md
.claude/agents/
.codex/agents/
.claude/rules/
docs/claude_code_subagents/
docs/agent_report_cards/
.claude/logs/

# Keep repo-managed support surfaces visible while ignoring generated skill packs
# by default. Approved public-safe exceptions stay explicit here.
!.claude/
!.codex/
.claude/hooks/*
!.claude/hooks/protect-managed-docs.sh
.claude/skills/**
.codex/skills/**
!.claude/skills/
!.codex/skills/
!.claude/settings.json

# Public-safe generated skill-pack exception
!.claude/skills/scribe-mcp-usage/
!.codex/skills/scribe-mcp-usage/
!.claude/skills/scribe-mcp-usage/**
!.codex/skills/scribe-mcp-usage/**

# -----------------------------------------------------
# Council / MCP integration (local-only)
# -----------------------------------------------------
.mcp.json
opencode.json
.opencode/
.agents/

# -----------------------------------------------------
# Generated packaging artifacts
# -----------------------------------------------------
src/scribe_mcp.egg-info/

# -----------------------------------------------------
# Example / Local-Only Code
# -----------------------------------------------------
example_code/

# -----------------------------------------------------
# OS Artifacts
# -----------------------------------------------------
.DS_Store
Thumbs.db
*:Zone.Identifier

# -----------------------------------------------------
# Coverage
# -----------------------------------------------------
.coverage
htmlcov/
