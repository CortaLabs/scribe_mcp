", \\\\\\\"response_data\\\\\\\": \\\\\\\"{\\\\\\\\\\\\\\\"chunks\\\\\\\\\\\\\\\": [{\\\\\\\\\\\\\\\"byte_end\\\\\\\\\\\\\\\": 66434, \\\\\\\\\\\\\\\"byte_start\\\\\\\\\\\\\\\": 60874, \\\\\\\\\\\\\\\"chunk_index\\\\\\\\\\\\\\\": 7, \\\\\\\\\\\\\\\"content\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\"            RETURNING id, project_id, metric_category, metric_name, metric_value, metric_unit,\\\\\\\\\\\\\\\\n                    baseline_value, improvement_percentage, collection_timestamp, metadata;\\\\\\\\\\\\\\\\n            \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\n            (project_id, metric_category, metric_name, metric_value,\\\\\\\\\\\\\\\\n             metric_unit, baseline_value, improvement_percentage, meta_json),\\\\\\\\\\\\\\\\n        )\\\\\\\\\\\\\\\\n        return PerformanceMetricsRecord(\\\\\\\\\\\\\\\\n            id=row[\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"id\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"],\\\\\\\\\\\\\\\\n            project_id=row[\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"project_id\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"],\\\\\\\\\\\\\\\\n            metric_category=row[\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"metric_category\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"],\\\\\\\\\\\\\\\\n            metric_name=row[\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"metric_name\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"],\\\\\\\\\\\\\\\\n            metric_value=row[\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"metric_value\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"],\\\\\\\\\\\\\\\\n            metric_unit=row[\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"metric_unit\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"],\\\\\\\\\\\\\\\\n            baseline_value=row[\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"baseline_value\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"],\\\\\\\\\\\\\\\\n            improvement_percentage=row[\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"improvement_percentage\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"],\\\\\\\\\\\\\\\\n            collection_timestamp=datetime.fromisoformat(row[\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"collection_timestamp\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"]),\\\\\\\\\\\\\\\\n            metadata=json.loads(row[\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"metadata\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"]) if row[\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"metadata\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"] else None,\\\\\\\\\\\\\\\\n        )\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n    # Agent session and project context management methods\\\\\\\\\\\\\\\\n    async def upsert_agent_session(self, agent_id: str, session_id: str, metadata: Optional[Dict[str, Any]]) -> None:\\\\\\\\\\\\\\\\n        \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"Create or update an agent session.\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n        await self._initialise()\\\\\\\\\\\\\\\\n        metadata_json = json.dumps(metadata or {}) if metadata else None\\\\\\\\\\\\\\\\n        async with self._write_lock:\\\\\\\\\\\\\\\\n            await self._execute(\\\\\\\\\\\\\\\\n                \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n                INSERT INTO agent_sessions (id, agent_id, started_at, last_active_at, status, metadata)\\\\\\\\\\\\\\\\n                VALUES (?, ?, CURRENT_TIMESTAMP, CURRENT_TIMESTAMP, 'active', ?)\\\\\\\\\\\\\\\\n                ON CONFLICT(id) DO UPDATE SET\\\\\\\\\\\\\\\\n                    last_active_at = CURRENT_TIMESTAMP,\\\\\\\\\\\\\\\\n                    status = 'active',\\\\\\\\\\\\\\\\n                    metadata = excluded.metadata;\\\\\\\\\\\\\\\\n                \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\n                (session_id, agent_id, metadata_json)\\\\\\\\\\\\\\\\n            )\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n    async def heartbeat_session(self, session_id: str) -> None:\\\\\\\\\\\\\\\\n        \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"Update session last_active_at timestamp.\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n        await self._initialise()\\\\\\\\\\\\\\\\n        async with self._write_lock:\\\\\\\\\\\\\\\\n            await self._execute(\\\\\\\\\\\\\\\\n                \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n                UPDATE agent_sessions\\\\\\\\\\\\\\\\n                SET last_active_at = CURRENT_TIMESTAMP\\\\\\\\\\\\\\\\n                WHERE id = ? AND status = 'active';\\\\\\\\\\\\\\\\n                \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\n                (session_id,)\\\\\\\\\\\\\\\\n            )\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n    async def end_session(self, session_id: str) -> None:\\\\\\\\\\\\\\\\n        \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"Mark a session as expired.\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n        await self._initialise()\\\\\\\\\\\\\\\\n        async with self._write_lock:\\\\\\\\\\\\\\\\n            await self._execute(\\\\\\\\\\\\\\\\n                \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n                UPDATE agent_sessions\\\\\\\\\\\\\\\\n                SET status = 'expired', last_active_at = CURRENT_TIMESTAMP\\\\\\\\\\\\\\\\n                WHERE id = ?;\\\\\\\\\\\\\\\\n                \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\n                (session_id,)\\\\\\\\\\\\\\\\n            )\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n    async def get_agent_project(self, agent_id: str) -> Optional[Dict[str, Any]]:\\\\\\\\\\\\\\\\n        \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"Get an agent's current project with version info.\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n        await self._initialise()\\\\\\\\\\\\\\\\n        row = await self._fetchone(\\\\\\\\\\\\\\\\n            \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n            SELECT agent_id, project_name, version, updated_at, updated_by, session_id\\\\\\\\\\\\\\\\n            FROM agent_projects\\\\\\\\\\\\\\\\n            WHERE agent_id = ?;\\\\\\\\\\\\\\\\n            \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\n            (agent_id,)\\\\\\\\\\\\\\\\n        )\\\\\\\\\\\\\\\\n        if not row:\\\\\\\\\\\\\\\\n            return None\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n        return {\\\\\\\\\\\\\\\\n            \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"agent_id\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\": row[\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"agent_id\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"],\\\\\\\\\\\\\\\\n            \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"project_name\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\": row[\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"project_name\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"],\\\\\\\\\\\\\\\\n            \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"version\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\": row[\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"version\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"],\\\\\\\\\\\\\\\\n            \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"updated_at\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\": row[\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"updated_at\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"],\\\\\\\\\\\\\\\\n            \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"updated_by\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\": row[\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"updated_by\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"],\\\\\\\\\\\\\\\\n            \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"session_id\\\\\\\\\\\